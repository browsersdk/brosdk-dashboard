{
  "name": "brosdk-dashboard-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/dashboard",
    "build": "npm run build --workspace apps/dashboard",
    "check": "npm run check --workspace apps/dashboard && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run test --workspace apps/dashboard && cargo test --workspace",
    "tauri:dev": "npm run dev --workspace apps/desktop",
    "tauri:build": "npm run build --workspace apps/desktop",
    "sdk:smoke": "cargo run -p sdk-host -- smoke --json",
    "sdk:runtime-smoke": "cargo build -p sdk-host && cargo run -p sdk-client --bin runtime-host-smoke",
    "manager:smoke": "cargo build -p sdk-host && cargo run -p manager --bin manager-smoke",
    "e2e:credential": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-credential-e2e.ps1",
    "e2e:environment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-environment-lifecycle-e2e.ps1",
    "e2e:environment-create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-environment-create-e2e.ps1",
    "e2e:multi-environment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-multi-environment-e2e.ps1",
    "e2e:ai-assistant": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-ai-assistant-e2e.ps1",
    "e2e:dashboard": "npm run e2e --workspace apps/dashboard",
    "e2e:dashboard:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-dashboard-desktop-e2e.ps1",
    "docs:screenshots": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capture-readme-screenshots.ps1",
    "e2e:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop-tray-e2e.ps1",
    "sdk:capabilities": "cargo run -p sdk-host -- capabilities --json",
    "ai:smoke": "cargo run -p ai-agent --bin ai-smoke",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-sidecar.ps1",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -PortableOnly",
    "release:verify:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-portable.ps1",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "release:windows:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -Msi",
    "release:test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-installer.ps1",
    "release:test:installer:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-installer.ps1 -FullDashboardE2e",
    "release:test:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-msi.ps1"
  }
}
