{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BroSDK Dashboard",
  "version": "0.1.0",
  "identifier": "com.brosdk.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../dashboard -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix ../dashboard",
    "frontendDist": "../../../apps/dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BroSDK Dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "script-src": "'self' http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:1420",
        "img-src": "'self' data: http://127.0.0.1:1420",
        "font-src": "'self' data: http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "BroSDK",
    "category": "DeveloperTool",
    "shortDescription": "Local multi-environment browser SDK dashboard",
    "longDescription": "BroSDK Dashboard manages browser environments, fingerprints, proxies, kernels, operations and controlled automation through an isolated local SDK runtime.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../libs/windows_x64/brosdk.dll": "brosdk/brosdk.dll"
    },
    "externalBin": ["bin/sdk-host"],
    "useLocalToolsDir": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/nsis-hooks.nsh",
        "startMenuFolder": "BroSDK"
      },
      "wix": {
        "upgradeCode": "30a62539-a61f-5ee6-a81e-064d37fd1968",
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
